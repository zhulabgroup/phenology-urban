\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.1.1}Compiling urban tree inventories}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Overview of study cities and their characteristics}. Panel (a): Geographic distribution of study cities across the CONUS, with circle size indicating the number of street trees. Panel (b): PCA plot of city-level mean annual temperature (\emph  {bio1}), mean annual precipitation (\emph  {bio12}), population density (\emph  {pop\_density}), median building height (\emph  {height\_median}), and the standard deviation of building height (\emph  {height\_sd}), with kernel density-based 2D contours illustrating the coverage of selected cities (blue) relative to all cities (gray); the overlaid contour lines represent the outer boundary of the estimated 2D density distribution at a threshold of 0.0001.}}{5}{}\protected@file@percent }
\newlabel{fig1:map}{{1}{5}{}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Extracting phenological metrics from PlanetScope}{5}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Comparing intra- and inter-urban variation in phenology}{6}{}\protected@file@percent }
