\@writefile{toc}{\contentsline {section}{\numberline {3}Results}{8}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Widespread intra-urban variation in phenology}{8}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Phenological distributions and variance partitioning of intra-urban and inter-urban components}. Panels (a) and (d) show the proportional contributions of intra-urban (dark gray) and inter-urban (light gray) components to variation in SOS and EOS, respectively, as estimated from mixed-effects models. Each bar associated with the phylogenetic tree represents one species. Panels (b) and (e) illustrate city-level distributions of the SOS (b) and EOS (e) for four representative species which differ in the proportion of variance. The colored horizontal bars indicate the median (dots) and the interquartile range (IQR, bar ends) within each city. The shaded areas represent the median and IQR of city-level median phenological dates. Panels (c) and (f) compare intra-urban (y-axis) and inter-urban (x-axis) IQR for all species, for SOS and EOS respectively. The dashed 1:1 line indicates where intra- and inter-urban variability would be equal.}}{8}{}\protected@file@percent }
\newlabel{fig2:variance}{{2}{8}{}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Phenology responds to fine-scale temperature heterogeneity}{9}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Phenological responses to urban thermal variation for species and city examples}. Panel (a) and (b) show spatial patterns of mean winter temperature and the SOS for \emph  {Acer rubrum} in New York City in 2023. Panel (c) illustrates the marginal relationship between SOS and mean winter temperature for \emph  {Acer rubrum} in New York City in 2023. Panels (d) and (e) summarize temperature sensitivities ($\beta _{\mathrm  {Temp}}$) estimated from spatial statistical models for all species in New York City, for SOS and EOS, respectively. Species along the x-axis are ordered according to their phylogenetic relationships.}}{9}{}\protected@file@percent }
\newlabel{fig3:nycexample}{{3}{9}{}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Phenological responses to intra-urban temperature variation across all species and cities}. Colors indicate the direction of the phenological response, and color intensity reflects the level of statistical significance. Panel (a) and (b) present heatmaps summarizing the phenological response types for each species-city combination for SOS and EOS, respectively. Species along the x-axis are ordered according to their phylogenetic relationships, whereas cities on the y-axis are arranged by latitude.}}{10}{}\protected@file@percent }
\newlabel{fig4:heatmap}{{4}{10}{}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Phenological responses vary with climatic context}{10}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Phenological responses to urban thermal variation across CONUS cities and their relationships with cities' climatic contexts}. Panels (a) and (b) map the spatial distribution of the city-level mean temperature sensitivity across all species present in each city, for SOS and EOS, respectively. Colors represent the magnitude of the average phenological temperature effect, and point sizes indicate the variance of species-specific temperature sensitivities within each city. Panels (c-d) show the univariate relationships between phenological temperature sensitivity and the urban climatic context for the 10 most common species across cities. Points and vertical bars indicate species-specific estimates of ($\beta _{\mathrm  {Temp}}$ with 95\% credible intervals. Solid lines show fitted ($\beta _{\mathrm  {Temp}}$-climatic context relationships obtained by repeatedly resampling posterior draws of $\beta _{\mathrm  {Temp}}$ and performing bootstrap resampling; the shaded areas represent the 95\% uncertainty bands across bootstrap replicates.}}{11}{}\protected@file@percent }
\newlabel{fig5:marginal}{{5}{11}{}{figure.5}{}}
