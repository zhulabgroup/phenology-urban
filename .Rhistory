tavg_allyear_var <- readRDS(paste0(r_input_dir, city, "/tavg_allyear_var.rds"))
if (phe_type == "SOS") {
phe_metric <- "doy"
direction <- "up"
thres <- 0.5
} else if (phe_type == "EOS") {
phe_metric <- "doy"
direction <- "down"
thres <- 0.5
} else if (phe_type == "GreenUp") {
phe_metric <- "doy_diff"
direction <- "up"
thres <- 0.2
tavg_allyear_var$doy_diff <- as.numeric(tavg_allyear_var$doy_diff)
} else {
phe_metric <- "doy_diff"
direction <- "down"
thres <- 0.2
tavg_allyear_var$doy_diff <- as.numeric(tavg_allyear_var$doy_diff)
}
model_path <- paste0(r_output_dir, city, "_", genus, "_tavg_", phe_type,  ".rds")
model_path
tavg_allyear_var_sf <- tavg_allyear_var %>%
filter(direction == !!direction & thres == !!thres & genus == !!genus) %>%
na.omit() %>%
st_as_sf(coords = c("lon", "lat"), crs = 4326) %>%
st_transform(crs = st_crs(boundary)) %>%
mutate(lon = st_coordinates(.)[,1], lat = st_coordinates(.)[,2],
year = as.factor(year))
tavg_allyear_var <- tavg_allyear_var_sf%>%
st_drop_geometry()
print(paste("City:",city, "Genus:",genus, "; metric:", nrow(tavg_allyear_var)))
print(paste("Type:", phe_type, "; metric:", phe_metric, "; direction:", direction, "; thres:", thres))
mean_doy_acer <- readRDS(paste0("~/phenology-urban/data/proc/urban/",city,"/tavg_allyear_var.rds")) %>%
filter(genus == !!genus & thres == !!thres & direction ==!!direction ) %>%
summarise(doy = mean(doy)) %>%
pull(doy)
if (phe_type == "EOS" | phe_type == "SOS") {
type = phe_type
} else if (phe_type == "GreenUp") {
type = "green-up pace"
} else {
type = "green-down pace"
}
preseason <- readRDS(paste0("~/phenology-urban/data/proc/urban/",city,"/tavg_allyear_pcorr.rds")) %>%
filter(genus == !!genus & type == !!type) %>%
summarise(pre = mean(optimal_pre_length)) %>%
pull(pre)
start_date = make_date(2023) + days(round(mean_doy_acer) - 1) - days(preseason)
end_date = make_date(2023) + days(round(mean_doy_acer) - 1)
NY_weather <- readRDS(paste0("~/urban-cooling/data/raw/WU/",city,"/",city,"_wu.rds")) %>%
filter(Date >= start_date & Date <= end_date) %>%
group_by(name) %>%
summarise(AvgTemp_mean = mean(AvgTemp),
Sum_mm_sum = sum(Sum_mm),
year = as.factor(2023))
NY_srad <- readRDS(paste0("~/phenology-urban/data/raw/",city,"/Daymet/daily2016-2024/srad_wu_2023.rds")) %>%
filter(time >= start_date & time <= end_date) %>%
group_by(Site) %>%
summarise(srad_mean = mean(value)) %>%
inner_join(NY_weather, by = c("Site" = "name"))
NY_srad <- readRDS(paste0("~/phenology-urban/data/raw/",city,"/Daymet/daily2016-2024/srad_wu_2023.rds"))
View(NY_srad)
############# clean srad for prediction #############
city = "HT"
data_dir <- paste0("~/phenology-urban/data/raw/", city, "/Daymet/daily2016-2024/")
file_list <- list.files(data_dir, pattern = "srad_daily_(2022|2023)_ncss\\.nc$", full.names = TRUE)
result <- NULL
points <- read_csv(paste0("~/urban-cooling/data/raw/WU/", city, "/location.csv"), show_col_types = FALSE) %>%
st_as_sf(coords = c("Lon", "Lat"), crs = 4326)
points_vect <- vect(points)
points <- st_drop_geometry(points)
for (file in file_list) {
srad_nc <- terra::rast(file)
extracted_values <- terra::extract(srad_nc, points_vect) %>%
dplyr::select(-ID)
colnames(extracted_values) <- as.character(time(srad_nc))
temp_result <- cbind(points["Site"], extracted_values) %>%
pivot_longer(
cols = -Site,
names_to = "time",
values_to = "value"
)
result <- bind_rows(result, temp_result)
}
saveRDS(result, paste0("~/phenology-urban/data/raw/", city, "/Daymet/daily2016-2024/srad_wu_2023.rds"))
############# clean srad for prediction #############
