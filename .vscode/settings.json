{
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "/usr/local/bin/latexmk",
      "args": [
        "-cd",
        "-r",
        "%DIR%/.latexmkrc",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=build",
        "%DOC%"
      ],
      "env": {
        "PATH": "/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": [
        "latexmk"
      ]
    }
  ]
}
