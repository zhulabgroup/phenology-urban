3. Add temperature - 2018 Birch - daymet
```{r}
# ------------------------------------ Get Daymet Data ------------------------------------ #
# download the Daymet data
library(daymetr)  # for getting Daymet data
library(ncdf4)  # for processing .nc data
library(janitor)  # for detecting cols with all records empty
library(gstat)  # for interpolation
library(sp)
library(sf)
library(raster)

folder.raw <- '~/phenology-urban/data/raw/CONUS/Daymet/test'

download_Daymet <- TRUE



us_boundary <- sf::read_sf('data/raw/CONUS/boundary/us_boundarydissolve.shp')
us_boundary <- st_set_crs(us_boundary, "EPSG:4326")

if (download_Daymet){
  # get LST extent
  bbox <- as.vector(terra::ext(us_boundary))
  # download Daymet data
  download_daymet_ncss(location = bbox[c('ymax', 'xmin', 'ymin', 'xmax')],
                       start = 2018, end = 2018,
                       frequency = "monthly",
                       param = c("tmin","tmax"),
                       path=folder.raw)
}

# open the netCDF variables
tmax.nc <- terra::rast("~/phenology-urban/data/raw/CONUS/Daymet/tmax_monavg_2018_ncss.nc")
tmin.nc <- terra::rast("~/phenology-urban/data/raw/CONUS/Daymet/tmin_monavg_2018_ncss.nc")

usboun_reproj <- sf::st_transform(us_boundary, crs = sf::st_crs(terra::crs(tmax.nc,proj = T)))

tmax <- terra::project(terra::mask (terra::crop(tmax.nc, terra::ext(usboun_reproj)),
                                    usboun_reproj), terra::crs(us_boundary))
tmin <- terra::project(terra::mask (terra::crop(tmin.nc, terra::ext(usboun_reproj)), 
                                    usboun_reproj), terra::crs(us_boundary))

tmax_spring <- (tmax[[3]]+tmax[[4]]+tmax[[5]])/3
tmin_spring <- (tmin[[3]]+tmin[[4]]+tmin[[5]])/3

tmax_summer <- (tmax[[6]]+tmax[[7]]+tmax[[8]])/3
tmin_summer <- (tmin[[6]]+tmin[[7]]+tmin[[8]])/3

tmax_autumn <- (tmax[[9]]+tmax[[10]]+tmax[[11]])/3
tmin_autumn <- (tmin[[9]]+tmin[[10]]+tmin[[11]])/3


tavg_ann <- (tmax[[1]] + tmin[[1]])/2
tavg_spring <- (tmax_spring + tmin_spring)/2
tavg_summer <- (tmax_summer + tmin_summer)/2
tavg_autumn <- (tmax_autumn + tmin_autumn)/2

writeRaster(tavg_autumn, filename = "data/proc/daymet/conus/tavg_autumn_2018.tif")
```

