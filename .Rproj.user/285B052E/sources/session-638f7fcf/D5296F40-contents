bootstrap_lm <- function(data, formula, num_iterations) {
  coefficients <- matrix(NA, nrow = num_iterations, ncol = length(coef(lm(formula, data))))
  for (i in 1:num_iterations) {
    bootstrap_sample <- data[sample(nrow(data), replace = TRUE), ]
    coefficients[i, ] <- coef(lm(formula, data = bootstrap_sample))
  }
  return(coefficients)
}

num_iterations <- 1000
coefficients_lm1 <- bootstrap_lm(data_neon, down ~ tavg_ann_2018, num_iterations)
coefficients_lm2 <- bootstrap_lm(data_city, down ~ tavg_ann_2018, num_iterations)
diff_coefficients <- coefficients_lm1 - coefficients_lm2
confidence_interval <- apply(diff_coefficients, 2, function(x) quantile(x, c(0.025, 0.975)))
print(confidence_interval)

